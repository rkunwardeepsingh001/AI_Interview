# Keep this file private; copy it to .env and set real values.
GOOGLE_API_KEY=add_your_rotated_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Local development default; change this before any non-local deployment.
RECRUITER_TOKEN=dev-recruiter-token-change-me
DATABASE_URL=sqlite:///./interviews.db
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PUBLIC_URL=http://localhost:5173

# SMTP settings are required to email candidate invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
